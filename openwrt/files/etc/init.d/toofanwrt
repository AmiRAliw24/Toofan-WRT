#!/bin/sh /etc/rc.common
# ToofanWrt router panel

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/toofanwrt

start_service() {
	local listen
	listen="$(uci -q get toofanwrt.main.listen)"
	[ -n "$listen" ] || listen=":80,:8080"

	local xray
	xray="$(uci -q get toofanwrt.main.xray)"
	[ -x "$xray" ] || xray=/usr/bin/xray
	local compat
	compat="$(uci -q get toofanwrt.main.xray_compat)"
	[ -x "$compat" ] || compat=""

	procd_open_instance
	procd_set_param command "$PROG" -listen "$listen" -config /etc/toofanwrt/config.json -xray "$xray" -xray-compat "$compat"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="16384 16384"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "toofanwrt"
}
