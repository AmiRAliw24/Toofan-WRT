#!/bin/sh /etc/rc.common
# Separ router panel

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/separ

start_service() {
	local listen
	listen="$(uci -q get separ.main.listen)"
	[ -n "$listen" ] || listen=":8080"

	procd_open_instance
	procd_set_param command "$PROG" -listen "$listen" -config /etc/separ/config.json -xray /usr/bin/xray
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="16384 16384"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "separ"
}
